# Database Configuration
# Required for production deployment - use Neon PostgreSQL
# Get your connection string from: https://console.neon.tech
# In Railway: this will be automatically set as DATABASE_URL if you link a Neon database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Server Configuration
# PORT: In Railway, this is automatically set to the port your service runs on
# HOST: In Railway, bind to 0.0.0.0 to accept connections
# NODE_ENV: Set to 'production' for Railway deployment
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Session Configuration (optional)
SESSION_SECRET=your-secret-key-change-this-for-production
