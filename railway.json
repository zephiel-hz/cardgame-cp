{
  "_redeploy": "2026-05-09T12:01:00Z",
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm run build",
    "nixpacks": {
      "providers": ["node"],
      "data": {
        "node": {
          "version": "20.10.0"
        }
      }
    }
  },
  "deploy": {
    "startCommand": "NODE_ENV=production node dist/index.cjs",
    "restartPolicyMaxRetries": 5
  },
  "env": {
    "NODE_VERSION": "20.10.0",
    "NODE_ENV": "production"
  }
}
