{
  "_redeploy": "2026-03-16T14:00:00Z",
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm cache clean --force && npm ci --include=dev && npm run build",
    "nixpacks": {
      "providers": ["node"]
    }
  },
  "deploy": {
    "startCommand": "NODE_ENV=production node dist/index.cjs",
    "restartPolicyMaxRetries": 5
  },
  "env": {
    "NODE_VERSION": "20.10.0",
    "NODE_ENV": "production"
  }
}
